# App Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=astrosaathi

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ASTROLOGY_USER_ID=your_astrologyapi_user_id
ASTROLOGY_API_KEY=your_astrologyapi_key

# Mock Provider (Set to true if you don't have API keys yet)
USE_MOCK_PROVIDER=true
