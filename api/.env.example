# Copy this file to api/.env and fill in real values. api/.env is git-ignored.

# App
NODE_ENV=development

# Database (Postgres in production, SQLite fallback in development)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_DATABASE=astrosaathi

# Redis (BullMQ background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379

# AstrologyAPI.com — https://astrologyapi.com
ASTROLOGY_USER_ID=your_astrologyapi_user_id
ASTROLOGY_API_KEY=your_astrologyapi_key

# Set to true to run without AstrologyAPI credentials
USE_MOCK_PROVIDER=false

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Razorpay — dashboard.razorpay.com > Settings > API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
